export PATH="${HOME}"/.local/bin:"${PATH}"
export PATH="${PATH}":"${HOME}"/.local/share/go/bin
export PATH="${PATH}":"${HOME}"/.local/share/npm/bin
[ -d "${HOMEBREW_PREFIX}" ] && export PATH="${HOMEBREW_PREFIX}"/sbin:"${HOMEBREW_PREFIX}"/bin:"${PATH}"
[ -d "${HOMEBREW_PREFIX}"/opt/openjdk/bin ] && export PATH="${HOMEBREW_PREFIX}"/opt/openjdk/bin:"${PATH}"

command -v gem > /dev/null && export PATH="$PATH":$(gem environment path | sed -r "s/:/\/bin:/")/bin